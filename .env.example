# Copy to .env (never commit it). Used by docker-compose.
WEBRECON_ADMIN_USER=admin
WEBRECON_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional: free key from https://nvd.nist.gov/developers/request-an-api-key (faster CVE lookups)
NVD_API_KEY=
# Set to 1 when served through an HTTPS reverse proxy (enables Secure cookies and HSTS)
WEBRECON_HTTPS=0